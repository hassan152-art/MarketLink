# MongoDB connection string.
# Local MongoDB:      mongodb://127.0.0.1:27017/marketlink
# MongoDB Atlas:       mongodb+srv://<user>:<password>@<cluster>.mongodb.net/marketlink
MONGODB_URI=mongodb://127.0.0.1:27017/marketlink

PORT=5000
JWT_SECRET=change-this-secret

# The URL of the deployed frontend (used to build the "reset password" link
# that gets emailed to users). For local dev this is the Vite dev server.
FRONTEND_URL=http://localhost:5173

# --- Google Sign-In -----------------------------------------------------
# Create an OAuth 2.0 Client ID (type: "Web application") at
# https://console.cloud.google.com/apis/credentials and put the Client ID
# here AND in frontend/.env as VITE_GOOGLE_CLIENT_ID (same value, both
# places). Add http://localhost:5173 (and your real domain later) to
# "Authorized JavaScript origins" on that credential.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# --- Forgot password emails ---------------------------------------------
# SMTP credentials used to send "reset your password" emails via Nodemailer.
# Example values for Gmail (use a 16-character "App Password", not your
# normal Gmail password: https://myaccount.google.com/apppasswords):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
#   SMTP_USER=you@gmail.com
#   SMTP_PASS=your-16-char-app-password
# If these are left blank, MarketLink still works in dev: instead of
# emailing the reset link, the server prints it to the console so you can
# copy/paste it into the browser while testing.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="MarketLink <no-reply@marketlink.com>"
